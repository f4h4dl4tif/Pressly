#!/bin/bash
# Launch Pressly for the logged-in user once installation finishes.
APP="/Applications/Pressly.app"
CONSOLE_USER=$(/usr/bin/stat -f %Su /dev/console)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ -d "$APP" ]; then
  USER_ID=$(/usr/bin/id -u "$CONSOLE_USER")
  /bin/launchctl asuser "$USER_ID" /usr/bin/sudo -u "$CONSOLE_USER" /usr/bin/open "$APP" || true
fi
exit 0
